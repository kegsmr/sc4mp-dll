# SC4MP claimed city warning. Packed into sc4mp-dll-ui.dat by tools/make-ui-dat.py; the control ids must match GuardDialog.cpp.
# Shown in the middle of the city view. The owner line is filled in by the DLL, which wraps it onto the hidden lines below it if it's long
# (0x7B3E9AD0 to 0x7B3E9AD4), and moves the windows under it down and grows the dialog to fit.
# It's built like the game's own titled dialogs (eg. Establish City): its steel frame {46a006b0,144161ee} stretched as an edge image, with the title in
# the frame's title band, the message in its inset beside the warning sign {46a006b0,14416243}, and its caption buttons {46a006b0,144161eb} below.
<LEGACY clsid=GZWinGen iid=IGZWinGen id=0x7B3E9AC1 area=(0,0,366,150) fillcolor=(0,0,0) caption=" " winflag_visible=yes winflag_enabled=yes winflag_moveable=yes winflag_sizeable=no winflag_sortable=no winflag_pbuff=no winflag_pbufftrans=yes winflag_pbufferase=yes winflag_pbuffvid=no winflag_alphablend=yes winflag_acceptfocus=no winflag_mousetrans=no winflag_ignoremouse=no image={46a006b0,144161ee} blttype=edge userdata=0 moveable=yes sizeable=no defaultkeys=no closevisible=no gobackvisible=no minmaxvisible=no closedisabled=no gobackdisabled=no minmaxdisabled=no titlebar=no fill=yes outline=no paint=yes sidebar=no gutters=(64,64) >
