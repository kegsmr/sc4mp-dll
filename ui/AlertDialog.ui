# SC4MP alert, eg. a save the server didn't take. Packed into sc4mp-dll-ui.dat by tools/make-ui-dat.py; the control ids must match GuardDialog.cpp.
# The same dialog as the claimed city warning (GuardDialog.ui), with the title and text filled in by the DLL, which wraps the text onto the hidden
# lines below the first (0x7B3E9AD0 to 0x7B3E9AD4) and grows the dialog to fit. Its OK button has the warning's close button's ID.
# Its top window isn't moveable by the game (moveable=no), like the warning's, since the DLL drags it by its title band.
<LEGACY clsid=GZWinGen iid=IGZWinGen id=0x7B3E9AC1 area=(0,0,366,150) fillcolor=(0,0,0) caption=" " winflag_visible=yes winflag_enabled=yes winflag_moveable=yes winflag_sizeable=no winflag_sortable=no winflag_pbuff=no winflag_pbufftrans=yes winflag_pbufferase=yes winflag_pbuffvid=no winflag_alphablend=yes winflag_acceptfocus=no winflag_mousetrans=no winflag_ignoremouse=no image={46a006b0,144161ee} blttype=edge userdata=0 moveable=no sizeable=no defaultkeys=no closevisible=no gobackvisible=no minmaxvisible=no closedisabled=no gobackdisabled=no minmaxdisabled=no titlebar=no fill=yes outline=no paint=yes sidebar=no gutters=(64,64) >
